# Copy this file to `.env` (same folder) and paste your real key.
# Get one at https://console.anthropic.com -> API Keys.
# .env is gitignored — the key never leaves your machine or Vercel's settings.
ANTHROPIC_API_KEY=sk-ant-...your-key-here...

# Optional: override the mentor's model (default: claude-opus-5)
# MENTOR_MODEL=claude-opus-5
